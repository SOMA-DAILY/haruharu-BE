# Airflow 로컬 환경 변수 (#390). 실제 값은 .env 에만 두고 커밋하지 않는다(secret-policy).
# 사용: cp .env.example .env

# 컨테이너 내부 파일 소유자 UID. macOS 는 50000 그대로, Linux 는 $(id -u).
AIRFLOW_UID=50000

# Airflow UI 호스트 포트 (8080 은 Spring 앱이 사용).
AIRFLOW_UI_PORT=8081

# 메타DB 암호화 키(Connection 비밀번호 저장용). 비워도 로컬은 동작하지만 재시작 후 Connection 복호화가 깨질 수 있어 생성 권장:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

# API/UI 세션 JWT 서명 키. 필수(비우면 기동 실패). 생성: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
AIRFLOW__API_AUTH__JWT_SECRET=

# Airflow UI 로그인 (로컬 전용 기본값 — 이 compose 는 127.0.0.1 에만 바인딩된다. 운영엔 이 compose 를 쓰지 않는다)
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=airflow

# ─── 하루하루 app 연결 ───
# 로컬 Spring 앱. 컨테이너에서 호스트로 나가므로 host.docker.internal.
HARUHARU_APP_BASE_URL=http://host.docker.internal:8080
# app 의 INTERNAL_BATCH_TOKEN 과 같은 값(32자 이상). 비어 있으면 app 이 전부 401 로 거부한다.
INTERNAL_BATCH_TOKEN=

# ─── 선택: Slack 알림 ───
# 실패·데드라인 초과 시 보낼 Incoming Webhook. 비우면 로그로만 남긴다.
HARUHARU_ALERT_SLACK_WEBHOOK_URL=

# ─── 선택: 데드라인(분) ───
# logical_date(스케줄 발화 04:00 KST) + 이 분 안에 안 끝나면 deadline_missed 콜백. 기본 15. 로컬 실험 시 1~2 로 줄여서 확인.
# (백필 실행은 기본 제외 — HARUHARU_ALERT_DEADLINE_INCLUDE_BACKFILL=true 로 포함 가능)
HARUHARU_CLEANUP_DEADLINE_MINUTES=15
