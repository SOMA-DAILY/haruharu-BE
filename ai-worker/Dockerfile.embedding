# Qwen3-Embedding-0.6B 추론 서비스(revision 고정, CPU). 이미지에 가중치를 넣어 시작 때 내려받지 않는다.
FROM python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:0.11 /uv /usr/local/bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
COPY reply_ai ./reply_ai
RUN uv sync --frozen --no-dev --extra embedding
ENV PATH="/app/.venv/bin:$PATH" HF_HOME=/app/hf
RUN python -c "from huggingface_hub import snapshot_download; snapshot_download('Qwen/Qwen3-Embedding-0.6B', revision='97b0c614be4d77ee51c0cef4e5f07c00f9eb65b3')"
ENV HF_HUB_OFFLINE=1
USER 10001
EXPOSE 18452
CMD ["reply-ai", "embedding-serve", "--host", "0.0.0.0", "--port", "18452"]
