{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "verdict": {"type": "string", "enum": ["appropriate", "inappropriate", "uncertain"]},
    "confidence": {"type": "string", "enum": ["high", "medium", "low"]},
    "stable_meaning": {"type": "boolean"},
    "unsupported_personalization": {"type": "boolean"},
    "reason": {"type": "string", "maxLength": 180}
  },
  "required": ["verdict", "confidence", "stable_meaning", "unsupported_personalization", "reason"],
  "additionalProperties": false
}
