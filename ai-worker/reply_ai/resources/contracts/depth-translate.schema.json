{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "context_en": {
      "type": "string",
      "maxLength": 240
    },
    "candidates": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "properties": {
          "card_id": {
            "type": "string"
          },
          "text_en": {
            "type": "string",
            "minLength": 1,
            "maxLength": 600
          }
        },
        "required": [
          "card_id",
          "text_en"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "context_en",
    "candidates"
  ],
  "additionalProperties": false
}
