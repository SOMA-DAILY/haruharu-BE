SPRING_PROFILES_ACTIVE=local

DB_URL=jdbc:postgresql://localhost:5432/haruharu
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

JWT_SECRET=your_jwt_secret_key_at_least_32_characters_here

KAKAO_CLIENT_ID=your_kakao_rest_api_key
APPLE_CLIENT_ID=your_apple_service_id_or_bundle_id

# ─── AWS S3 (프로필 이미지 · 영상 업로드) ───
# REGION/BUCKET 은 비밀 아님. ACCESS_KEY 류는 로컬 개발 전용(yaml 금지).
# 운영(EC2)은 IAM 역할(haruharu-ec2-role)로 동작하므로 KEY 불필요.
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=haruharu-dev-media
AWS_S3_PRESIGN_EXPIRY=300
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ─── RevenueCat (인앱 결제 웹훅 검증) ───
# webhook Authorization 헤더 공유 시크릿. dev/prod yaml 에서 사용.
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret


# ─── PortOne (PASS 본인인증) ───
PORTONE_STORE_ID=
PORTONE_V2_API_SECRET=
PORTONE_CHANNEL_KEY=

# ─── 실명인증 CI/DI 암호화 ───
# AES-256-GCM 암호화 및 blind index 파생용 마스터 키. 32자 이상 랜덤 문자열 권장.
IDENTITY_ENCRYPTION_KEY=


# ─── FCM (푸시 알림 발송) ───
# Firebase 서비스 계정 JSON 을 base64 한 줄로 인코딩한 값. 미설정 시 로컬은 no-op 발송.
FCM_SERVICE_ACCOUNT_JSON=your_fcm_service_account_json_base64

# ─────────────────────────────────────────────────────────────
# 배포용: 아래는 .env 가 아니라 GitHub Environment(dev/prod)에 등록한다.
# deploy.yml 이 받아 EC2 접속/주입에 사용하므로 EC2 에 직접 만들 필요 없다.
#
#   Secrets   EC2_HOST  EC2_USER  EC2_SSH_KEY(PEM 전체)
#             DB_URL  DB_USERNAME  DB_PASSWORD  JWT_SECRET  KAKAO_CLIENT_ID  APPLE_CLIENT_ID  REVENUECAT_WEBHOOK_SECRET
#   Variables APP_PORT (예: 18080)  AWS_REGION  AWS_S3_BUCKET(예: haruharu-prod-media)
#   GITHUB_TOKEN 은 자동 — 등록 불필요
#   ※ AWS_ACCESS_KEY_ID/SECRET 은 운영에선 EC2 IAM 역할이 대신하므로 등록 불필요
# ─────────────────────────────────────────────────────────────
