SPRING_PROFILES_ACTIVE=local

DB_URL=jdbc:postgresql://localhost:5432/haruharu
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

JWT_SECRET=your_jwt_secret_key_at_least_32_characters_here

KAKAO_CLIENT_ID=your_kakao_rest_api_key
APPLE_CLIENT_ID=your_apple_service_id_or_bundle_id

# ─── AWS S3 (프로필 이미지 · 영상 업로드) ───
# REGION/BUCKET 은 비밀 아님. ACCESS_KEY 류는 로컬 개발 전용(yaml 금지).
# 운영(ECS)은 태스크 역할(haruharu-app-task-role)로 동작하므로 KEY 불필요.
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=haruharu-dev-media
AWS_S3_PRESIGN_EXPIRY=300
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key

# ─── RevenueCat (인앱 결제 웹훅 검증) ───
# webhook Authorization 헤더 공유 시크릿. dev/prod yaml 에서 사용.
REVENUECAT_WEBHOOK_SECRET=your_revenuecat_webhook_secret


# ─── PortOne (PASS 본인인증) ───
PORTONE_STORE_ID=
PORTONE_V2_API_SECRET=
PORTONE_CHANNEL_KEY=

# ─── 실명인증 CI/DI 암호화 ───
# AES-256-GCM 암호화 및 blind index 파생용 마스터 키. 32자 이상 랜덤 문자열 권장.
IDENTITY_ENCRYPTION_KEY=


# ─── FCM (푸시 알림 발송) ───
# Firebase 서비스 계정 JSON 을 base64 한 줄로 인코딩한 값. 미설정 시 로컬은 no-op 발송.
FCM_SERVICE_ACCOUNT_JSON=your_fcm_service_account_json_base64

# ─── 매칭 정책 (비밀 아님 · GitHub Variables 로 관리) ───
# 매칭 신청비(구름). 신청 차감 = 미성사 환불 = 불발 통지 개수. 미설정 시 기본 5.
MATCHING_ENTER_COST=5

# ─── 미션 JIT 배정 (비밀 아님) ───
# 슬롯 오픈 전 배정 선행 시간, 1회 처리 상한, 실행 주기, 결정 로그의 배포 코드 식별자.
MISSION_ASSIGNMENT_ENABLED=true
MISSION_ASSIGNMENT_LEAD_MINUTES=60
MISSION_ASSIGNMENT_BATCH_SIZE=100
MISSION_ASSIGNMENT_CRON="0 * * * * *"
MISSION_ASSIGNMENT_POLICY=RULE_V1

# ─── 미션 outcome 확정 (비밀 아님) ───
# 시간창 종료 후 집계까지의 여유, 1회 처리 상한, 실행 주기.
MISSION_OUTCOME_ENABLED=true
MISSION_OUTCOME_SETTLE_MINUTES=5
MISSION_OUTCOME_BATCH_SIZE=100
# assignment(0초)와 같은 초 금지 — Batch JobRepository 직렬화 충돌로 한쪽이 실행되지 못한다.
MISSION_OUTCOME_CRON="30 * * * * *"
APPLICATION_COMMIT_SHA=local

# ─── 내부 배치 트리거 API (#389 · 비밀) ───
# 외부 오케스트레이터(Airflow)가 X-Internal-Token 헤더로 보내는 공유 시크릿. 32자 이상 랜덤 권장.
# 비어 있으면 /internal/batch/** 는 전부 401(fail-closed). 운영은 Secrets Manager 로 주입.
INTERNAL_BATCH_TOKEN=
# 알림 정리 @Scheduled 런처 on/off. Airflow 가 스케줄을 맡으면 false (Job 은 남아 트리거 API 로 실행).
NOTIFICATION_CLEANUP_SCHEDULER_ENABLED=true

# ─── 운영 채팅 시스템 유저 (#455 · #474 · 비밀 아님) ───
# 운영 글·운영자 미션 카드 발신 전용 ACTIVE 시스템 유저 ID(닉네임 '하루'). 일반 회원·운영자 로그인 계정과 분리한다.
# scripts/sql/455-chat-p0-base-verify.sql 로 id 를 확인해 app·admin 양쪽에 같은 값을 넣는다.
# 비어 있으면 방 편성 발송 잡이 기동을 거부하고, 0이면 미션 발송은 FAILED 로 기록된다.
CHAT_SYSTEM_USER_ID=

# ─────────────────────────────────────────────────────────────
# 배포(ECS)는 GitHub Actions OIDC 로 AWS 역할(github-actions-deploy-policy)을 assume 한다.
# 앱 시크릿(DB/JWT/OAuth 등)은 GitHub 이 아니라 AWS Secrets Manager 에 저장되고
# ECS Task Definition 이 컨테이너에 주입한다 → 워크플로우엔 앱 시크릿을 등록하지 않는다.
#
#   image-build.yml  develop 머지 → ARM64 이미지 빌드 → ECR 푸시(:sha, :develop)
#   deploy-ecs.yml   수동(workflow_dispatch) → 선택 SHA 로 task def 리비전 등록 → ECS 배포
#
#   AWS 인증         OIDC 역할만 사용(장기 액세스 키 불필요)
#   Secrets Manager  haruharu/app · haruharu/app-dev · haruharu/admin · haruharu/admin-dev
# ─────────────────────────────────────────────────────────────
