# Database
DB_URL=jdbc:postgresql://localhost:5432/haruharu
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# JPA
DDL_AUTO=validate

# JWT (secret must be at least 32 characters)
JWT_SECRET=your_jwt_secret_key_at_least_32_characters_here
JWT_ACCESS_TOKEN_EXPIRY_MS=1800000
JWT_REFRESH_TOKEN_EXPIRY_MS=2592000000

# Kakao OAuth (REST API 키)
KAKAO_CLIENT_ID=your_kakao_rest_api_key

# Apple OAuth (Services ID 또는 Bundle ID)
APPLE_CLIENT_ID=your_apple_service_id_or_bundle_id
