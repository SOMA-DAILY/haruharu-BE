#!/bin/bash
# 시크릿 하드코딩 감지 pre-commit 훅

STAGED=$(git diff --staged --name-only)

# 1. 프로필 yaml 파일 커밋 차단
BLOCKED=$(echo "$STAGED" | grep -E "application-(local|dev|prod|staging)[.-].*\.(yml|yaml)$")
if [ -n "$BLOCKED" ]; then
    echo "BLOCKED: 프로필 yaml 파일은 git에 올릴 수 없습니다."
    echo "$BLOCKED"
    exit 1
fi

# 2. application*.yaml 에서 하드코딩된 시크릿 탐지
YAML_FILES=$(echo "$STAGED" | grep -E "application.*\.(yml|yaml)$")
for file in $YAML_FILES; do
    SECRETS=$(git show ":$file" 2>/dev/null \
        | grep -nE "^\s*(password|secret|token|api.?key|credentials|private.?key)\s*:" \
        | grep -v "^\s*#" \
        | grep -v "\${")
    if [ -n "$SECRETS" ]; then
        echo "BLOCKED: $file 에 하드코딩된 시크릿이 감지되었습니다."
        echo "$SECRETS"
        exit 1
    fi
done

exit 0
